# ── Vesper-light 配置 ──
#
# 复制成 .env 再改：cp .env.example .env
# 改完重启要带 --update-env：pm2 restart vesper-light --update-env
#
# 最小可用配置只有三行：LAMP_MIOT_URL、LAMP_MIOT_TOKEN、LIGHT_MCP_TOKEN。
# 其余全都有默认值，不填也能跑。

# ══ 底层米家服务 ══
# 服务器上已经在跑的 lamp_server.py（手写 JSON-RPC over HTTP，只听 127.0.0.1）。
# 这个库不重写米家通信，所有真正的开关调光都转给它。
LAMP_MIOT_URL=http://127.0.0.1:8890/mcp
# ~/miot-lamp/lamp_token 里那串。别贴进聊天、日志或 URL。
LAMP_MIOT_TOKEN=
LAMP_MIOT_TIMEOUT_MS=20000
# 灯在米家里的显示名，只用于说话和页面标题
LAMP_NAME=桌面台灯

# ══ 自己这个服务 ══
LIGHT_PORT=3003
# 默认只听本机。要从外面访问，用 Caddy 反代挂到域名的子路径上，别直接开防火墙。
LIGHT_BIND=127.0.0.1
# 管理页的登录。留空 = 页面不开（不做无密码的控制页）。
LIGHT_BASIC_USER=
LIGHT_BASIC_PASS=
# MCP 端点 /lamp/mcp 的口令。留空 = 端点不开。
# 生成：openssl rand -hex 24
LIGHT_MCP_TOKEN=
TIME_ZONE=Asia/Shanghai
LIGHT_DB=data/light.db

# ══ 和晨暮星之间的桥（全部可选，不配就只少几样东西）══
# 晨暮星的 vesper 进程地址和它的 REPORT_STATUS_API_KEY
VESPER_URL=http://127.0.0.1:3001
VESPER_API_KEY=
# 1 = 睡前守护这类事可以让晨暮星发一条消息进 Aru 对话（走它的 bark）
VESPER_NOTIFY=1
# 1 = 定时和守护自己动手之后，往晨暮星的对话记录里写一行，
#     这样允朔下次醒来知道「灯在 23:30 自己暗下去了」
VESPER_CONVERSATION_LOG=1
# 1 = 睡前守护可以读晨暮星的「她正在做的事」（时间感知），
#     她还在干活时先只轻调一档，不一路压到底
VESPER_READ_DOING=1
AI_DISPLAY_NAME=允朔
USER_DISPLAY_NAME=小满

# ══ 睡前守护 ══
# 到点了灯还开着，就一档一档调暗。永远不关灯——关灯是她自己的动作。
LAMP_GUARD=1
# 第一档什么时候开始
LAMP_BEDTIME=23:30
# 一档一档的目标亮度，逗号分隔。只往下走，不会把灯调亮。
LAMP_GUARD_STAGES=40,20,8
# 两档之间隔多少分钟
LAMP_GUARD_STEP_MINUTES=15
# 最低到这里就停，再也不往下调，也绝不关灯
LAMP_GUARD_FLOOR=5
# 调暗时顺手把色温调暖（2700 最暖）。填 0 = 不动色温。
LAMP_GUARD_WARM=2700
# 守护窗口到几点结束。过了这个点就不再动灯——
# 免得白天进程重启后突然把灯调暗。
LAMP_GUARD_WINDOW_END=03:00
# 她正在做一件还没到点的事时，后面几档整体推迟多少分钟
LAMP_GUARD_BUSY_DELAY_MINUTES=20
# 最多因为「还在忙」推迟几次。到了上限就接着往下调。
LAMP_GUARD_BUSY_MAX_DELAYS=2
# 1 = 第一档调暗时说一句（走晨暮星的 bark，或自己的 Bark）
LAMP_GUARD_NOTIFY=1

# ══ 定时 ══
# 服务停机错过的定时，超过这么久就标记 missed，不补执行。
# 照抄底层服务那个设计：避免半夜突然开灯。
LAMP_SCHEDULE_GRACE_MINUTES=15
# 最多同时挂多少个没执行的定时
LAMP_MAX_PENDING=30

# ══ 兜底通知 ══
# 没接晨暮星时，直接用自己的 Bark key 叮一声。两个都没有就只写日志。
LAMP_BARK_KEY=
LAMP_BARK_TITLE=台灯
